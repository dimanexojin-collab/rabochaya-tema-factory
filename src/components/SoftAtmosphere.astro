<div class="soft-atmosphere" aria-hidden="true">
  <div class="soft-atmosphere__light soft-atmosphere__light--one"></div>
  <div class="soft-atmosphere__light soft-atmosphere__light--two"></div>
  <svg class="soft-atmosphere__threads" viewBox="0 0 1000 1000" fill="none">
    <g>{[0,1,2,3,4].map((i) => <path d={`M${260+i*42} -80C${-130+i*42} 180 ${1040+i*42} 500 ${390+i*42} 1100`} />)}</g>
  </svg>
</div>
<script>
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const update = () => root.toggleAttribute('data-atmosphere-paused', document.hidden || reduced.matches);
  document.addEventListener('visibilitychange', update);
  reduced.addEventListener('change', update);
  update();
</script>
