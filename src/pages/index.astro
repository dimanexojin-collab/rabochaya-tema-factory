---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InspectionStage from '../components/InspectionStage.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import ProductGrid from '../components/ProductGrid.astro';
import NewsCard from '../components/NewsCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../config/site.ts';
import { products, categories, hits, news, priceGroups } from '../data/catalog.ts';
import { articles } from '../data/articles.ts';
import { img, alt } from '../lib/images.ts';
import { url } from '../lib/paths.ts';
import { formatFrom } from '../lib/format.ts';
import { pickTitle, fitDescription, TAILS } from '../lib/seo.ts';
const hitList = hits().filter((p) => p.id !== 'perchatki-pvh-10-klass-serye').slice(0, 4);
const minPvh = Math.min(...priceGroups.flatMap((g) => g.rows).map((r) => r.priceFrom ?? Infinity));
const title = pickTitle('Рабочие перчатки с ПВХ от производителя в Архангельске');
const description = fitDescription(`Собственное производство рабочих перчаток х/б и с ПВХ 7 и 10 класса в Архангельске: оптом ${formatFrom(minPvh)} за пару с НДС, а также рукавицы, респираторы, беруши и сапоги.`, ...TAILS);
---
<Base title={title} description={description}>
  <section class="factory-hero container" aria-labelledby="hero-title">
    <div class="factory-hero__intro">
      <p class="mono eyebrow"><span class="signal" aria-hidden="true"></span> Производство / Архангельск</p>
      <h1 id="hero-title">Защита для<br /><span>вашей работы</span></h1>
      <p class="factory-hero__lead">Производим рабочие перчатки в Архангельске. Подбираем средства защиты для предприятий и бригад — оптом и в розницу.</p>
      <div class="btn-row"><a class="btn btn--light" href={url('/katalog/')}>Подобрать защиту <span aria-hidden="true">↗</span></a><a class="btn btn--ghost" href={url('/optom/')}>Оптовый прайс</a></div>
      <p class="factory-hero__location mono">Свой цех. Свой подход к качеству.</p>
    </div>
    <InspectionStage />
  </section>

  <div class="factory-facts container" aria-label="О компании">
    <div><span class="mono">Собственное производство</span><p>7 / 10 <small>класс вязки</small></p></div>
    <div><span class="mono">Оптовые заказы</span><p>С НДС <small>по счёту</small></p></div>
    <div><span class="mono">В каталоге</span><p>{products.length} <small>товаров / {categories.length} категорий</small></p></div>
    <a href={url('/kontakty/')}><span class="mono">Офис и розничный отдел</span><p>Архангельск <span aria-hidden="true">↗</span></p><span class="factory-facts__address">{SITE.address.street}</span></a>
  </div>

  <section class="section container factory-categories" aria-labelledby="cats-title">
    <div class="section-heading" data-reveal><div><p class="mono eyebrow">Каталог продукции</p><h2 id="cats-title">Защита под<br />вашу задачу</h2></div><a class="text-link" href={url('/katalog/')}>Все товары <span aria-hidden="true">↗</span></a></div>
    <CategoryCarousel />
  </section>

  <section class="section container" aria-labelledby="hits-title">
    <div class="section-heading" data-reveal><div><p class="mono eyebrow">Выбор покупателей</p><h2 id="hits-title">Проверено работой</h2></div><a class="text-link" href={url('/katalog/')}>Открыть каталог ↗</a></div>
    <ProductGrid products={hitList} even />
  </section>

  <section class="section container factory-production" aria-labelledby="prod-title">
    <div class="factory-production__image" data-reveal><Picture src={img('ceh')} alt={alt('ceh')} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" /><div class="mono">Производство / Архангельск</div></div>
    <div class="factory-production__copy" data-reveal><p class="mono eyebrow"><span class="signal signal--green" aria-hidden="true"></span> Своё производство</p><h2 id="prod-title">От пряжи<br />до готовой пары</h2><p>Вяжем трикотажные перчатки 7 и 10 класса с ПВХ и без покрытия. Цех, офис и розничный отдел — в Архангельске.</p><p>В прайсе указываем текс, чтобы вы могли сравнить плотность пряжи. Под заказ меняем размеры, плотность и цвета.</p><a class="btn btn--ghost" href={url('/proizvodstvo/')}>Как устроено производство ↗</a><div class="production-details"><span class="mono">7 / 10 класс</span><span class="mono">ПВХ / без покрытия</span></div></div>
  </section>

  <section class="section container" aria-labelledby="supply-title">
    <div class="section-heading" data-reveal><div><p class="mono eyebrow">Работаем с вашим заказом</p><h2 id="supply-title">От задачи к поставке</h2></div></div>
    <ol class="supply-steps"><li data-reveal><span class="mono">01 / Подбор</span><h3>Что нужно вашей команде?</h3><p>Выберите позиции в каталоге или расскажите о задаче. Поможем с выбором перчаток и СИЗ.</p></li><li data-reveal><span class="mono">02 / Расчёт</span><h3>Прайс и счёт с НДС</h3><p>Уточним количество и подготовим счёт. Оптовые цены вынесены в отдельный прайс.</p></li><li data-reveal><span class="mono">03 / Согласование</span><h3>Договоримся о получении</h3><p>Способ передачи заказа и условия доставки согласуем с вами при оформлении.</p></li></ol>
    <div class="resource-links">{articles.slice(0,3).map((a) => <a href={url(`/stati/${a.slug}/`)}>{a.title}<span aria-hidden="true">↗</span></a>)}</div>
  </section>

  <section class="section container" aria-labelledby="news-title">
    <div class="section-heading" data-reveal><div><p class="mono eyebrow">Журнал компании</p><h2 id="news-title">Новости и продукция</h2></div><a class="text-link" href={url('/novosti/')}>Все публикации ↗</a></div>
    <ul class="grid grid--3" role="list">{news.slice(0,3).map((n) => <li><NewsCard item={n} level={3} /></li>)}</ul>
  </section>
  <CtaBand />
</Base>
